{
  "application": {
    "name": "ELIT21 Shopify AliExpress Autonomous Manager",
    "data_dir": "data",
    "log_file": "logs/elit21.log",
    "database": "data/elit21.db",
    "poll_seconds": 60,
    "worker_threads": 2,
    "dry_run": true,
    "live_orders": false
  },
  "shopify": {
    "shop": "your-shop.myshopify.com",
    "access_token": "",
    "api_version": "2026-07",
    "webhook_secret": "",
    "webhook_base_url": "https://elit21.com",
    "webhook_port": 8080
  },
  "aliexpress": {
    "app_key": "",
    "app_secret": "",
    "access_token": "",
    "gateway": "https://eco.taobao.com/router/rest",
    "iop_gateway": "https://api-sg.aliexpress.com/rest",
    "oauth_url": "https://api-sg.aliexpress.com/oauth/authorize",
    "country": "CA",
    "currency": "CAD",
    "language": "EN"
  },
  "pricing": {
    "markup_percent_before_shipping": 100.0,
    "round_to_cents": true,
    "minimum_price_cad": 5.0,
    "maximum_price_cad": 5000.0
  },
  "sourcing": {
    "minimum_seller_score": 90.0,
    "minimum_product_rating": 4.2,
    "minimum_orders": 20,
    "maximum_delivery_days": 45,
    "auto_publish": false
  },
  "inventory": {
    "safety_buffer": 2,
    "out_of_stock_quantity": 0,
    "sync_batch_size": 50
  },
  "risk": {
    "maximum_order_value_cad": 750.0,
    "require_valid_canadian_postal_code": true,
    "block_po_boxes": false
  },
  "automation": {
    "catalog_sync": true,
    "inventory_sync": true,
    "price_sync": true,
    "order_processing": true,
    "tracking_sync": true,
    "reports": true
  },
  "terminal": {
    "refresh_ms": 500,
    "fixed_dashboard": true,
    "event_lines": 8
  },
  "network": {
    "request_timeout_seconds": 45,
    "connect_timeout_seconds": 10,
    "maximum_response_megabytes": 16,
    "verify_tls": true,
    "ca_bundle": "",
    "proxy_url": ""
  }
}
